<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Email</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.2.0</Version>
    <!-- x-release-please-end -->
    <Description>Transactional email through Brevo, with reply-to, attachments, a typed address check, receipt limits, a send result instead of exceptions, a branded email layout, and delivery statistics with an admin endpoint.</Description>
    <PackageTags>email;brevo;transactional-email;smtp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Email.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
