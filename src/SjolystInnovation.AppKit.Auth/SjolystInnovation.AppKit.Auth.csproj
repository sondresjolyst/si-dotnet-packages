<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Auth</PackageId>
    <!-- x-release-please-start-version -->
    <Version>0.1.0</Version>
    <!-- x-release-please-end -->
    <Description>JWT access tokens, rotating refresh tokens with reuse detection, and password reset and email verification codes for ASP.NET Core Identity apps.</Description>
    <PackageTags>jwt;refresh-token;identity;password-reset;email-verification</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Auth.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>
