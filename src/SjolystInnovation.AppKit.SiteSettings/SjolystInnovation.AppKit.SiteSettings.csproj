<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.SiteSettings</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.1.1</Version>
    <!-- x-release-please-end -->
    <Description>Admin-managed company details, branding, legal pages, and page sections for ASP.NET Core apps, with Norwegian organization number checks and stable error codes.</Description>
    <PackageTags>settings;company-info;branding;legal-pages;page-sections;cms;organisasjonsnummer;minimal-api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.SiteSettings.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>
</Project>
