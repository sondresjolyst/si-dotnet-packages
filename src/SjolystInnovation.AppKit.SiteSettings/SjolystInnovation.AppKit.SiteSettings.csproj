<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.SiteSettings</PackageId>
    <!-- x-release-please-start-version -->
    <Version>0.1.0</Version>
    <!-- x-release-please-end -->
    <Description>Admin-managed company details and site branding for ASP.NET Core apps: settings, public company info and logo and icon uploads, with Norwegian organisation number and postal code checks.</Description>
    <PackageTags>settings;company-info;branding;organisasjonsnummer;minimal-api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.SiteSettings.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
</Project>
