<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Vipps</PackageId>
    <!-- x-release-please-start-version -->
    <Version>0.1.0</Version>
    <!-- x-release-please-end -->
    <Description>A client for the Vipps MobilePay Recurring, ePayment, Userinfo and Webhooks APIs, with webhook signature checks.</Description>
    <PackageTags>vipps;mobilepay;payments;recurring;epayment;webhooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Vipps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>
</Project>
