<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Vipps</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.3.0</Version>
    <!-- x-release-please-end -->
    <Description>A client for the Vipps MobilePay Recurring, ePayment, Userinfo and Webhooks APIs, with signed webhook endpoints that dedupe events, webhook registration at startup and Norwegian phone number checks.</Description>
    <PackageTags>vipps;mobilepay;payments;recurring;epayment;webhooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Vipps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
</Project>
