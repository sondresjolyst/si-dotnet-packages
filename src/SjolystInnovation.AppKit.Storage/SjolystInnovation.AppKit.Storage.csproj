<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Storage</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.0.0</Version>
    <!-- x-release-please-end -->
    <Description>Uploaded files on local disk for ASP.NET Core apps: named file stores that detect the type from the file's first bytes, refuse oversized and unknown files, guard against path traversal, and serve files with a correctly encoded Content-Disposition.</Description>
    <PackageTags>file-storage;uploads;content-disposition;minimal-api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Storage.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
