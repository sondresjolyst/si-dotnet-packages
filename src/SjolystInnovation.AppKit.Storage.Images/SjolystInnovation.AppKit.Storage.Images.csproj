<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Storage.Images</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.0.1</Version>
    <!-- x-release-please-end -->
    <Description>Content images for ASP.NET Core apps, with resized WebP renditions, EXIF orientation, recorded dimensions, cache-friendly serving, and cleanup of unreferenced images.</Description>
    <PackageTags>images;webp;skiasharp;uploads;entity-framework-core;minimal-api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Storage.Images.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SjolystInnovation.AppKit.Storage\SjolystInnovation.AppKit.Storage.csproj" />
  </ItemGroup>
</Project>
