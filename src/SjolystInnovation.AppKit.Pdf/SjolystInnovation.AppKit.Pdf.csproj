<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SjolystInnovation.AppKit.Pdf</PackageId>
    <!-- x-release-please-start-version -->
    <Version>1.1.1</Version>
    <!-- x-release-please-end -->
    <Description>HTML to PDF through headless Chromium with PuppeteerSharp: A4 with backgrounds, one browser reused across calls, scripts and network requests off by default, the sandbox on, and a render timeout.</Description>
    <PackageTags>pdf;html-to-pdf;chromium;puppeteer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SjolystInnovation.AppKit.Pdf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PuppeteerSharp" Version="25.13.1" />
  </ItemGroup>
</Project>
